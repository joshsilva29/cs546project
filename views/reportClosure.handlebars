<h1>Report Closure</h1>
{{#if serverError}}
    <div id="server-error">
        <p>{{error}}</p>
        {{#if hasMissingFields}}
            <ul>
                {{#each missingFields}}
                    <li>{{this}}</li>
                {{/each}}
            </ul>
        {{/if}}
    </div>
{{/if}}
<p id="client-error"></p>
<p id="success-message"></p>

<form id="report-closure-form">
    <label for="on_street_name">On Street</label>
    <input type="text" id="on_street_name" name="on_street_name">
    <br>

    <label for="from_street_name">From Street</label>
    <input type="text" id="from_street_name" name="from_street_name">
    <br>

    <label for="to_street_name">To Street</label>
    <input type="text" id="to_street_name" name="to_street_name">
    <br>

    <label for="date_reported">Date Reported</label>
    <input type="date" id="date_reported" name="date_reported">
    <br>

    <label for="ongoing">
        <input type="checkbox" id="ongoing" name="ongoing" checked>
        Closure is still ongoing
    </label>
    <br>

    <label for="work_end_date">Work End Date</label>
    <input type="date" id="work_end_date" name="work_end_date" disabled>
    <br>

    <label for="latitude">Latitude (optional)</label>
    <input type="text" id="latitude" name="latitude">
    <br>

    <label for="longitude">Longitude (optional)</label>
    <input type="text" id="longitude" name="longitude">
    <br>

    <label for="affects_sidewalk">
        <input type="checkbox" id="affects_sidewalk" name="affects_sidewalk">
        Affects sidewalk
    </label>
    <br>

    <label for="affects_roads">
        <input type="checkbox" id="affects_roads" name="affects_roads">
        Affects roads
    </label>
    <br>

    <label for="affects_bike_lanes">
        <input type="checkbox" id="affects_bike_lanes" name="affects_bike_lanes">
        Affects bike lanes
    </label>
    <br>

    <button type="submit" name="submitButton" id="submitButton">Submit</button>
</form>

<script src="https://code.jquery.com/jquery-3.5.1.js"
integrity="sha256-QWo7LDvxbWT2tbbQ97B53yJnYU3WhH/C8ycbRAkjPDc=" crossorigin="anonymous"></script>
{{!-- get user's id (needed to know who reported it) --}}
<script>
    const currentUserId = {{#if userId}}"{{userId}}"{{else}}null{{/if}};
</script>
{{!-- import helpers --}}
<script src="/public/js/form_validate.js"></script>
<script src="/public/js/reportClosure.js"></script>
