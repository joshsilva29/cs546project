<div id="search-container">
    <form id="search_form">
        <label for="search_input">
            Type in street name
        </label>
        <input type="text" name="search_input" id="search_input">
        <button type="submit">Submit</button>
    </form>
    <p>Type of Closure</p>
    <div class="search-options">
        <button onclick="toggleOption('all')" id="all">All</button>
        <button onclick="toggleOption('user-reported')" id="user-reported">User-Reported</button>
        <button onclick="toggleOption('nyc')" id="nyc">NYC Open Data</button>
    </div>
    <p>Closure Status</p>
    <div class="search-options">
        <button onclick="toggleClosureType('all')" id="allClosures">All</button>
        <button onclick="toggleClosureType('inactive')" id="inactive">Inactive</button>
        <button onclick="toggleClosureType('active')" id="active">Active</button>
    </div>
    <h3>Closures</h3>

    <div id="results"></div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.js"
integrity="sha256-QWo7LDvxbWT2tbbQ97B53yJnYU3WhH/C8ycbRAkjPDc=" crossorigin="anonymous"></script>
<script src="../public/js/search.js"></script>
