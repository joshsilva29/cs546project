<div id="search-container">
    <form id="search_form">
        <label for="search_input" id="for_search_input">
            Search
        </label>
        <input type="text" name="search_input" placeholder="Type in street name" id="search_input">
        <button type="submit" class="search-page-button">Submit</button>
    </form>
    <div id="filters">
        <div class="filter-section">
            <div>Type of Closure</div>
            <div class="search-options">
                <button onclick="toggleOption('all')" id="all" class="search-page-button">All</button>
                <button onclick="toggleOption('user-reported')" id="user-reported" class="search-page-button">User-Reported</button>
                <button onclick="toggleOption('nyc')" id="nyc" class="search-page-button">NYC Open Data</button>
            </div>
        </div>
        <div class="filter-section">
            <div>Closure Status</div>
            <div class="search-options">
                <button onclick="toggleClosureType('all')" id="allClosures" class="search-page-button">All</button>
                <button onclick="toggleClosureType('inactive')" id="inactive" class="search-page-button">Inactive</button>
                <button onclick="toggleClosureType('active')" id="active" class="search-page-button">Active</button>
            </div>
        </div>
    </div>
    <h3>Closures</h3>

    <div id="results"></div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.js"
integrity="sha256-QWo7LDvxbWT2tbbQ97B53yJnYU3WhH/C8ycbRAkjPDc=" crossorigin="anonymous"></script>
<script src="../public/js/search.js"></script>
